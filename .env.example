# ---- LLM backbones (set at least one; with none set the mock provider is used) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# OpenAI-compatible endpoint, e.g. an endpoint fronted by a real FortiAIGate / AI gateway.
# When set, provider "compat" becomes available. Pair with GUARD_MODE=proxy to let the
# real gateway do input inspection (output DLP and tool-call control still run locally).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Which provider to use by default: openai | anthropic | compat | mock
DEFAULT_PROVIDER=

# ---- Guard ----
GUARD_MODE=sim            # sim | proxy
SHADOW_RUN=1              # when the gateway blocks at input, still run the bare model to show the would-have-been score

# ---- Event ----
APP_NAME=FortiAIGate Arena
EVENT_CODE=default        # separates leaderboards between events
ADMIN_KEY=                # required for /#/admin facilitator console and /api/admin/export
UNLOCK_ALL=               # set to 1 to let players jump to any level (useful for demos)
RATE_LIMIT_PER_MIN=20
ATTACK_MAX_CHARS=10000

# ---- Storage ----
DATA_DIR=./data           # on Railway mount a volume here
PORT=8080
